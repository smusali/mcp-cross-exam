{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smusali/mcp-cross-exam/blob/main/mcp_cross_exam/probes.v1.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "family", "default_severity", "mutates", "revisions"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "family": { "type": "string", "minLength": 1 },
      "default_severity": { "enum": ["info", "low", "medium", "high"] },
      "mutates": { "type": "boolean" },
      "revisions": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
