{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smusali/mcp-cross-exam/blob/main/mcp_cross_exam/report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "target",
    "server",
    "run",
    "coverage",
    "score",
    "score_version",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "score_version": { "const": 1 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "tool": { "$ref": "#/$defs/tool" },
    "target": { "$ref": "#/$defs/target" },
    "server": { "$ref": "#/$defs/server" },
    "run": { "$ref": "#/$defs/run" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mcp_version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "mcp_version": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "url",
        "command",
        "protocol_version",
        "guard",
        "bearer_env",
        "expired_bearer_env",
        "header_env"
      ],
      "properties": {
        "transport": { "enum": ["http", "sse", "stdio"] },
        "url": { "type": ["string", "null"] },
        "command": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "protocol_version": { "type": ["string", "null"] },
        "guard": { "type": "string" },
        "bearer_env": { "type": ["string", "null"] },
        "expired_bearer_env": { "type": ["string", "null"] },
        "header_env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "server_info", "capabilities", "extensions"],
      "properties": {
        "revision": { "type": "string" },
        "server_info": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "extensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_s", "max_calls_per_tool", "call_timeout_s"],
      "properties": {
        "wall_clock_s": { "type": "number" },
        "max_calls_per_tool": { "type": "integer" },
        "call_timeout_s": { "type": "number" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "seed", "started_at", "finished_at", "budget"],
      "properties": {
        "run_id": { "type": "string" },
        "seed": { "type": "integer" },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "budget": { "$ref": "#/$defs/budget" }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "tool", "reason"],
      "properties": {
        "probe_id": { "type": "string" },
        "tool": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "probes_run", "skipped"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "probes_run": { "type": "array", "items": { "type": "string" } },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/skip" } }
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "transcript"],
      "properties": {
        "command": { "type": "string" },
        "transcript": { "type": ["string", "null"] }
      }
    },
    "blastRadius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "effect_source", "scope", "scope_source", "agent_impact"],
      "properties": {
        "effect": { "enum": ["read", "write", "destructive", "external"] },
        "effect_source": { "enum": ["configured", "declared", "observed", "default"] },
        "scope": { "enum": ["user", "tenant", "global"] },
        "scope_source": { "enum": ["configured", "declared", "observed", "default"] },
        "agent_impact": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "family",
        "tool",
        "severity",
        "severity_source",
        "title",
        "detail",
        "declared",
        "observed",
        "evidence",
        "repro",
        "blast_radius",
        "spec_refs",
        "fingerprint",
        "raw_penalty",
        "penalty"
      ],
      "properties": {
        "probe_id": { "type": "string" },
        "family": { "type": "string" },
        "tool": { "type": ["string", "null"] },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "severity_source": { "enum": ["default", "config"] },
        "title": { "type": "string" },
        "detail": { "type": ["string", "null"] },
        "declared": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
          ]
        },
        "observed": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
          ]
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "repro": { "$ref": "#/$defs/repro" },
        "blast_radius": { "$ref": "#/$defs/blastRadius" },
        "spec_refs": { "type": "array", "items": { "type": "string" } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raw_penalty": { "type": "integer", "minimum": 0 },
        "penalty": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
