{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smusali/mcp-cross-exam/blob/main/mcp_cross_exam/snapshot.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["hash", "snapshot_version", "tools"],
  "properties": {
    "snapshot_version": { "const": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definition", "hash", "name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "definition": { "type": "object" }
        }
      }
    }
  }
}
